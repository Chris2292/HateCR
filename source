    pivot = coverage.pivot(
        index="population", columns="target_confidence", values="percentage"
    ).reindex(
        index=["all_comments", "hostility_balanced", "hate_balanced_experimental"],
        columns=ASSIGNMENT_ORDER,
    ).fillna(0)
