        context = {
            "event_id": spec.get("event_id"),
            "media_id": None,
            "media_handle": None,
            "query": spec.get("query"),
            "start_time": spec.get("start_time"),
            "end_time": spec.get("end_time"),
        }

        tweets, audit = collect_tweets_with_archive_fallback(
