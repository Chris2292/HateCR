    fig.patch.set_facecolor("#FAFAF8")
    ax.set_facecolor("#FAFAF8")
    left = np.zeros(len(pivot))
    for confidence, color in zip(ASSIGNMENT_ORDER, colors):
        values = pivot[confidence].to_numpy(dtype=float)
